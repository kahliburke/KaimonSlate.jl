{
  "_comment": "Front-end third-party dependency manifest: each package's pinned version, the CDN directory its files come from (`{version}` substituted), and the files Slate uses (globs: `*` within a directory, `**` across). The server fetches a file on first request (or in the background at hub start), checks it against the SHA-384 in vendor.lock.json, caches it OUTSIDE the repo, and serves it from /assets/vendor/<package>@<version>/<subpath>. To upgrade, bump a `version`, run `KaimonSlate.NotebookServer.update_vendor_lock()`, and commit both files. See server_vendor.jl.",

  "echarts":      { "version": "5.5.1",   "base": "https://cdn.jsdelivr.net/npm/echarts@{version}/dist/",
                    "files": ["echarts.min.js"] },
  "katex":        { "version": "0.19.1",  "base": "https://cdn.jsdelivr.net/npm/katex@{version}/dist/",
                    "files": ["katex.min.js", "katex.min.css", "contrib/*.min.js", "fonts/*.woff2"] },

  "preact":       { "version": "10.24.3", "base": "https://cdn.jsdelivr.net/npm/preact@{version}/",
                    "files": ["dist/preact.module.js*", "hooks/dist/hooks.module.js*"] },
  "signals":      { "version": "1.3.0",   "base": "https://cdn.jsdelivr.net/npm/@preact/signals@{version}/",
                    "files": ["dist/signals.module.js*"] },
  "signals-core": { "version": "1.8.0",   "base": "https://cdn.jsdelivr.net/npm/@preact/signals-core@{version}/",
                    "files": ["dist/signals-core.module.js*"] },
  "htm":          { "version": "3.1.1",   "base": "https://cdn.jsdelivr.net/npm/htm@{version}/",
                    "files": ["dist/htm.module.js*", "preact/index.module.js*"] },

  "html2canvas":  { "version": "1.4.1",   "base": "https://cdn.jsdelivr.net/npm/html2canvas@{version}/dist/",
                    "files": ["html2canvas.min.js"] },
  "dagre":        { "version": "3.0.0",   "base": "https://cdn.jsdelivr.net/npm/@dagrejs/dagre@{version}/dist/",
                    "files": ["dagre.min.js", "dagre.min.js.map"] }
}
