<?xml version="1.0" encoding="utf-8"?>
<!-- Brief author-year citations in brackets: [Sun 2026], [Sun 2026; Elder 2025], [Boozer 2023a].
     The first author's surname and the year; the reference list is ordered by author and keyed by
     the same label. Shipped with Slate as the `author-year-brackets` bibstyle. -->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" demote-non-dropping-particle="sort-only">
  <info>
    <title>Author-year in brackets</title>
    <id>author-year-brackets</id>
    <updated>2026-10-01T00:00:00+00:00</updated>
  </info>
  <!-- In-text labels carry only the first author's surname: their et-al uses "and others", which is
       blanked here, so the reference list keeps its "et al.". -->
  <locale>
    <terms>
      <term name="and others"></term>
    </terms>
  </locale>
  <macro name="label">
    <group delimiter=" ">
      <names variable="author">
        <name form="short" et-al-min="2" et-al-use-first="1" delimiter-precedes-et-al="never"/>
        <et-al term="and others"/>
        <substitute>
          <text variable="title" form="short"/>
        </substitute>
      </names>
      <group>
        <date variable="issued">
          <date-part name="year"/>
        </date>
        <text variable="year-suffix"/>
      </group>
    </group>
  </macro>
  <macro name="first-author-sort">
    <names variable="author">
      <name name-as-sort-order="all" et-al-min="2" et-al-use-first="1"/>
    </names>
  </macro>
  <citation disambiguate-add-year-suffix="true">
    <sort>
      <key macro="first-author-sort"/>
      <key variable="issued"/>
    </sort>
    <layout prefix="[" suffix="]" delimiter="; ">
      <text macro="label"/>
    </layout>
  </citation>
  <bibliography hanging-indent="true" entry-spacing="1">
    <sort>
      <key macro="first-author-sort"/>
      <key variable="issued"/>
      <key variable="title"/>
    </sort>
    <layout suffix=".">
      <text macro="label" prefix="[" suffix="] "/>
      <group delimiter=", ">
        <names variable="author">
          <name initialize-with=". " delimiter=", " and="text" et-al-min="6" et-al-use-first="3"/>
        </names>
        <text variable="title" quotes="true"/>
        <text variable="container-title" font-style="italic"/>
        <date variable="issued">
          <date-part name="year"/>
        </date>
        <text variable="URL"/>
      </group>
    </layout>
  </bibliography>
</style>
